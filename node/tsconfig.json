{
  "compilerOptions": {
    "declaration": true,
    "target": "ES6",
    "module": "commonjs",
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
