# Packagist installs the PHP SDK from GitHub's archive of a tag, which leaves out
# these paths: a PHP install gets composer.json, LICENSE, README.md and php/lib/.
/.github export-ignore
/config export-ignore
/java export-ignore
/node export-ignore
/openapi export-ignore
/python export-ignore
/scripts export-ignore
/php/docs export-ignore
/php/test export-ignore
/php/.gitignore export-ignore
/php/.openapi-generator export-ignore
/php/.openapi-generator-ignore export-ignore
/php/.php-cs-fixer.dist.php export-ignore
/php/composer.json export-ignore
/php/git_push.sh export-ignore
/php/phpunit.xml.dist export-ignore
/php/.travis.yml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
